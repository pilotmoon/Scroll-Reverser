/* corresponds to Accessibility in system Privacy settings */
"Accessibility" = "Bedienungshilfen";

/* Preferences pane for `App` settings; also the kind of source that is an app posting scrolling of its own */
"App" = "App";

/* Label before the pop-up menu that chooses how automatic update checks are handled */
"Automatic checks:" = "Automatische Prüfung:";

/* Button, when pressed, checks for an update now */
"Check for Update" = "Nach Updates suchen";

/* Scrolling direction: the opposite of natural scrolling */
"Classic" = "Klassisch";

/* Scrolling type of a source that scrolls continuously, like a trackpad */
"Continuous" = "Kontinuierlich";

/* Accessibility label of the button that shows a source's details */
"Details" = "Details";

/* Tooltip of the button that shows a source's details */
"Details and horizontal scrolling" = "Details und horizontales Scrollen";

/* Scrolling type of a source that scrolls in steps, like a scroll wheel */
"Discrete" = "Schrittweise";

/* 1=name of app e.g. `Enable Scroll Reverser` */
"Enable %1$@" = "%1$@ aktivieren";

/* Source info: label before the date the source first scrolled */
"First seen:" = "Zuerst erkannt:";

/* No comment provided by engineer. */
"For settings, click the icon in the menu bar" = "Klicke auf das Symbol in der Menüleiste, um die Einstellungen zu öffnen.";

/* Source info: label before the horizontal scrolling menu */
"Horizontal scrolling:" = "Horizontales Scrollen:";

/* Source info: label before the identifier of the source's settings */
"Identifier:" = "Kennung:";

/* Check box: Include beta versionss of the app when checking for updates */
"Include beta versions" = "Beta-Versionen einbeziehen";

/* Automatic updates menu item: download and install updates without asking */
"Install automatically" = "Automatisch installieren";

/* Sources table: the source scrolled within the last minute */
"Just now" = "Gerade eben";

/* Source info: label before the kind of source, such as Mouse or App */
"Kind:" = "Art:";

/* Sources table column header: when the source last scrolled */
"Last used" = "Zuletzt benutzt";

/* Kind of source: a mouse, or any other device that isn't a trackpad */
"Mouse" = "Maus";

/* Kind of source: a mouse on another Mac, used through Universal Control */
"Mouse (Universal Control)" = "Maus (Universelle Steuerung)";

/* Source info: label before the source's name field */
"Name:" = "Name:";

/* Scrolling direction: natural scrolling, as in System Settings */
"Natural" = "Natürlich";

/* Automatic updates menu item: check for updates and ask before installing them */
"Notify only" = "Nur benachrichtigen";

/* Automatic updates menu item: don't check for updates automatically */
"Off" = "Aus";

/* No comment provided by engineer. */
"OK" = "OK";

/* 1=`Accessibility` */
"Open %1$@ preferences" = "%1$@ in den Systemeinstellungen öffnen";

/* Source info: label before the location of an app */
"Path:" = "Pfad:";

/* Section title */
"Permissions" = "Berechtigungen";

/* Source info: label before the total distance the source has scrolled, as a number of points (the unit of distance on screen) */
"Points scrolled:" = "Gescrollt (Punkte):";

/* 1=name of app e.g. `Quit Scroll Reverser` */
"Quit %1$@" = "%1$@ beenden";

/* Tooltip for the button below the sources table */
"Remove the selected source. It will be added again if it scrolls." = "Ausgewählte Quelle entfernen. Sie wird erneut hinzugefügt, sobald sie scrollt.";

/* Source info: label before the name the device or app reports */
"Reported name:" = "Gemeldeter Name:";

/* 1=`Accessibility` */
"Request %1$@ permission" = "Berechtigung für %1$@ anfordern";

/* Scrolling menu item: reverse the direction of scrolling posted by an app */
"Reversed" = "Umgekehrt";

/* No comment provided by engineer. */
"Scroll Reverser is now running!" = "Scroll Reverser läuft jetzt!";

/* No comment provided by engineer. */
"Scroll Reverser needs Accessibility permission to modify your scrolling." = "Scroll Reverser benötigt die Berechtigung für Bedienungshilfen, um dein Scrollen zu ändern.";

/* Preferences pane for `Scrolling` settings; also the sources table column header for natural or classic scrolling */
"Scrolling" = "Scrollen";

/* Source info: label before Continuous or Discrete */
"Scrolling type:" = "Scrollart:";

/* Hint shown once, pointing to a source's details button, the first time a scroll wheel scrolls horizontally */
"Set horizontal scrolling for this source here." = "Horizontales Scrollen für diese Quelle hier einstellen.";

/* Menu item that opens the settings window, including the trailing ellipsis */
"Settings…" = "Einstellungen …";

/* Prefs check box */
"Show in menu bar" = "In der Menüleiste anzeigen";

/* Sources table column header: the device or app that scrolls */
"Source" = "Quelle";

/* Prefs check box */
"Start at login" = "Beim Anmelden starten";

/* Shown in the empty sources table, which fills with devices and apps as they scroll */
"Start scrolling to see your devices here." = "Einfach scrollen, um die Geräte hier anzuzeigen.";

/* Sources table column header: scroll wheel step size */
"Step size" = "Schrittweite";

/* Source info: label before the direction the system delivers the source's scrolling in, such as Natural */
"System direction:" = "Systemrichtung:";

/* Kind of source: a trackpad */
"Trackpad" = "Trackpad";

/* Kind of source: a trackpad on another Mac, used through Universal Control */
"Trackpad (Universal Control)" = "Trackpad (Universelle Steuerung)";

/* Scrolling menu item: leave scrolling as the system delivers it */
"Unchanged" = "Unverändert";

/* Name and kind of a source of scrolling that is a device the system can't identify */
"Unidentified device" = "Nicht identifiziertes Gerät";

/* Name and kind of a source of scrolling that is neither a device nor an app */
